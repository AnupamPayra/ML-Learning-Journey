





import pandas as pd
import numpy as np
import matplotlib.pyplot as plt


dataset = pd.read_csv('Algerian_forest_fires_dataset.csv', header=1) #here header=1 help to take 1st record as individual features


dataset.head()


dataset.columns = [x.strip().lower() for x in dataset.columns ]


dataset.info()





df = dataset.copy()


df.head(2)





df.isnull().sum()


df[df.isnull().any(axis=1)] # It just help to see column wise missing value.





df.loc[:122, "region"] = 0
df.loc[122:, "region"] = 1


df['region'] = df['region'].astype('int')


df.dtypes


df.drop(index=122, inplace=True)


df[df.isnull().any(axis=1)]


df['classes'] = df['classes'].fillna(df['classes'].mode()[0])


df.isnull().sum()


df.reset_index(drop=True)


df.shape


df.loc[[122]] # Feature name contain as record at 122 due second reigon dataset.


df.drop(index=122, inplace=True)
df.reset_index(drop=True)


for feature in ['day', 'month',	'year',	'temperature',	'rh',	'ws']:
    df[feature] = df[feature].astype('int')


df.dtypes


df['rain'] = df['rain'].astype(float)
df['ffmc'] = df['ffmc'].astype(float)
df['dmc'] = df['dmc'].astype(float)





df[df['dc'] == '14.6 9']


df.loc[166, 'dc'] = df.loc[166, 'dc'].split(' ')[0]


df['isi'] = df['isi'].astype(float)
df['bui'] = df['bui'].astype(float)





df[df['fwi'] == 'fire   ']


df.loc[166, 'fwi'] = df['fwi'].mode()[0]


df['fwi'] = df['fwi'].astype(float)


df['dc'] = df['dc'].astype(float)


df.dtypes


df.describe()


df.to_csv('Cleaned_forest_dataset.csv', index=False)



