def corr_chk(df, threshold):
    corr_matrix = df.corr()
    high_corr = set()
    for row in range(len(corr_matrix.columns)):
        for col in range(row):
            if abs(corr_matrix.iloc[row, col]) > threshold:
                high_corr.add(corr_matrix.columns[row])
    return high_corr


print(corr_chk(df, 0.8))








